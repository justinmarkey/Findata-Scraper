# Copy to .env. This template is committed; .env is ignored.
# Never paste secrets into chat or commit the populated file.

# Reports: a comma-separated address list is supported by email delivery.
REPORT_TO=you@example.com
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=

# OpenBB keys; leave blank for public providers.
FMP_API_KEY=
INTRINIO_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Only required for direct SEC access: application name and a real contact email.
SEC_USER_AGENT=

# Private cloud state (S3 or a compatible service).
FINDATA_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=

# Optional public configuration override.
# FINDATA_CONFIG=/absolute/path/to/settings.toml
